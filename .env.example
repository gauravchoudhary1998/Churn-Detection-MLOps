# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- AWS ---
AWS_PROFILE=
AWS_REGION=us-east-1

# --- MLflow ---
# Local file-store tracking by default; set to a remote server URI if you stand one up.
MLFLOW_TRACKING_URI=file:./mlruns

# --- Kaggle API (used in Phase 2 to pull the Telco churn dataset) ---
KAGGLE_USERNAME=
KAGGLE_KEY=
