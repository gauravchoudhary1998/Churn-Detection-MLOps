# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- AWS ---
AWS_PROFILE=default
AWS_REGION=us-east-1

# --- MLflow ---
# SQLite-backed local tracking. Deliberately not a plain `file:` store: the
# MLflow Model Registry requires a database-backed tracking store, so a plain
# file store would let training/logging work but fail at model registration.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

