# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.egg

# --- Virtual environments ---
.venv/
venv/
env/

# --- Environment / secrets ---
.env
*.pem
*.key
kaggle.json
.aws/

# --- DVC ---
# DVC manages ignoring actual data files itself, per-directory, via the
# data/raw/.gitignore and data/processed/.gitignore it generates on `dvc add`
# (a blanket rule here would git-ignore the .dvc pointer files too).
/.dvc/cache
/.dvc/tmp

# --- MLflow ---
mlruns/
mlartifacts/
mlflow.db

# --- Model artifacts ---
*.pkl
*.joblib
*.tar.gz
model/

# --- Terraform ---
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfvars
!terraform/*.tfvars.example
terraform/.terraform.lock.hcl
terraform/crash.log

# --- Jupyter ---
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
